# =============================================================================
# Synology DSM connection
# =============================================================================

# Full base URL of DSM, including scheme and port.
# LAN example:  https://192.168.1.10:5001
# QuickConnect and DDNS hostnames also work.
SYNOLOGY_URL=https://192.168.1.10:5001

# Dedicated DSM account. Do NOT use an administrator account.
# Create a limited user in DSM and grant it only the shared folders it needs.
SYNOLOGY_USER=notion-mcp
SYNOLOGY_PASSWORD=

# Optional 6-digit code when the account has 2-step verification enabled.
# A static value only works for the moment it is valid, so for unattended
# deployments prefer an account WITHOUT 2FA that is locked down by permissions.
SYNOLOGY_OTP=

# Set to true only for a DSM using a self-signed certificate on the LAN.
# Leave false whenever the certificate is valid.
SYNOLOGY_INSECURE_TLS=false

# Session lifetime hint in seconds. The client re-authenticates automatically
# when DSM reports an expired session, so this is only a proactive refresh.
SYNOLOGY_SESSION_TTL_SECONDS=1800

# =============================================================================
# Safety policy
# =============================================================================

# Master switch. When true, every mutating tool is refused.
# Strongly recommended for the first deployment.
SYNOLOGY_READONLY=true

# Permanently deleting files is gated separately from ordinary writes.
SYNOLOGY_ALLOW_DELETE=false

# Restart/shutdown DSM, control Docker containers, change service state.
SYNOLOGY_ALLOW_SYSTEM_CONTROL=false

# The raw DSM WebAPI escape hatch (dsm_api_call). Gives access to every API the
# DSM exposes, so it inherits the account permissions and nothing more.
SYNOLOGY_ALLOW_GENERIC_API=false

# Comma-separated allowlist of File Station paths. Empty means every path the
# DSM account can already reach. Paths are shared-folder rooted, not /volume1.
# Example: /Documents,/AI-Inbox,/Downloads
SYNOLOGY_ALLOWED_PATHS=

# Comma-separated denylist, always applied even inside allowed paths.
SYNOLOGY_DENIED_PATHS=

# Largest file the read_file tool will pull into the conversation.
SYNOLOGY_MAX_READ_BYTES=1048576

# =============================================================================
# Transport
# =============================================================================

# "http" for a hosted deployment, "stdio" for a local desktop MCP client.
SYNOLOGY_MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# Require each MCP client to authenticate with `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
SYNOLOGY_MCP_TOKEN=

# Host binding used by docker-compose.
SYNOLOGY_HOST_BIND=127.0.0.1
SYNOLOGY_HOST_PORT=3020

# =============================================================================
# Reliability
# =============================================================================

SYNOLOGY_REQUEST_TIMEOUT_MS=30000
SYNOLOGY_MAX_RETRIES=2
LOG_LEVEL=info
